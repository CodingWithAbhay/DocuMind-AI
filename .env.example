# Google Gemini API key for generating document and query embeddings
# Get yours from: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Groq Cloud API key for lightning-fast LLM completions
# Get yours from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional Configurations & Overrides
EMBEDDING_MODEL=models/gemini-embedding-001
GROQ_MODEL=qwen/qwen3.8-27b
MAX_UPLOAD_MB=25
